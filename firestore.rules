rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function notificationAfter(id, recipient, kind, postId) {
      let notice = getAfter(/databases/$(database)/documents/notifications/$(id)).data;
      return notice.actorId == request.auth.uid && notice.recipientId == recipient
        && notice.type == kind && notice.postId == postId
        && notice.createdAt == request.time && notice.read == false;
    }

    function validUser() {
      return request.resource.data.keys().hasOnly([
          'username',
          'description',
          'profileImageUrl',
          'profileImagePublicId'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.username.matches('[^/]+')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.profileImageUrl is string
        && request.resource.data.profileImageUrl.size() <= 2048
        && request.resource.data.profileImagePublicId is string
        && request.resource.data.profileImagePublicId.size() <= 255
        && ((request.resource.data.profileImageUrl == ''
            && request.resource.data.profileImagePublicId == '')
          || (request.resource.data.profileImageUrl != ''
            && request.resource.data.profileImagePublicId != ''));
    }

    function validProfileImage(userId) {
      let data = request.resource.data;
      return (data.profileImageUrl == '' && data.profileImagePublicId == '')
        || (data.profileImageUrl.matches('https://res[.]cloudinary[.]com/iufz7yvd/image/upload/.*')
          && data.profileImagePublicId.matches('spotly/profiles/' + userId + '/[^/]+'));
    }

    match /users/{userId} {
      allow get: if signedIn();
      // Consultas acotadas de perfiles públicos; privateUsers sigue sin permitir listados.
      allow list: if signedIn() && request.query.limit > 0 && request.query.limit <= 20;
      allow create: if owns(userId) && validUser()
        && request.resource.data.description == ''
        && request.resource.data.profileImageUrl == ''
        && request.resource.data.profileImagePublicId == ''
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId
        && getAfter(/databases/$(database)/documents/privateUsers/$(userId)).data.email == request.auth.token.email;
      allow update: if owns(userId)
        && validUser()
        && validProfileImage(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description',
          'profileImageUrl',
          'profileImagePublicId'
        ]);
      // El borrado de cuenta necesita un flujo de servidor que limpie la reserva.
      allow delete: if false;
    }

    match /privateUsers/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/users/$(userId))
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.username is string;
      // Cambiar email o borrar cuenta requiere un flujo específico con Firebase Auth.
      allow update, delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if false;
    }

    // Relaciones públicas entre cuentas; solo el seguidor puede crearlas o quitarlas.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'followedId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followedId is string
        && request.resource.data.followedId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followedId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followedId))
        && notificationAfter('follow_' + followId, request.resource.data.followedId, 'follow', '');
      allow update: if false;
      allow delete: if owns(resource.data.followerId)
        && !existsAfter(/databases/$(database)/documents/notifications/$('follow_' + followId));
    }

    match /notifications/{noticeId} {
      function validNotice() {
        let data = request.resource.data;
        return data.keys().hasOnly(['recipientId', 'actorId', 'type', 'postId', 'createdAt', 'read'])
          && data.actorId == request.auth.uid && data.recipientId is string
          && data.recipientId != request.auth.uid && data.postId is string
          && data.createdAt == request.time && data.read == false
          && exists(/databases/$(database)/documents/users/$(data.actorId))
          && exists(/databases/$(database)/documents/users/$(data.recipientId));
      }
      function newFollow() {
        let data = request.resource.data;
        let relation = /databases/$(database)/documents/follows/$(data.actorId + '_' + data.recipientId);
        return data.type == 'follow' && data.postId == ''
          && noticeId == 'follow_' + data.actorId + '_' + data.recipientId
          && !exists(relation)
          && getAfter(relation).data.followerId == data.actorId
          && getAfter(relation).data.followedId == data.recipientId
          && getAfter(relation).data.createdAt == request.time;
      }
      function newLike() {
        let data = request.resource.data;
        let like = /databases/$(database)/documents/posts/$(data.postId)/likes/$(data.actorId);
        return data.type == 'like' && data.postId != ''
          && noticeId == 'like_' + data.postId + '_' + data.actorId
          && get(/databases/$(database)/documents/posts/$(data.postId)).data.authorId == data.recipientId
          && !exists(like) && getAfter(like).data.createdAt == request.time;
      }
      function actionRemoved() {
        let data = resource.data;
        return (data.type == 'follow'
            && !existsAfter(/databases/$(database)/documents/follows/$(data.actorId + '_' + data.recipientId)))
          || (data.type == 'like'
            && !existsAfter(/databases/$(database)/documents/posts/$(data.postId)/likes/$(data.actorId)));
      }
      allow get: if owns(resource.data.recipientId);
      allow list: if owns(resource.data.recipientId) && request.query.limit > 0 && request.query.limit <= 50;
      // No se puede inventar un aviso ni repetirlo si la acción ya existía.
      allow create: if signedIn() && validNotice() && (newFollow() || newLike());
      allow update: if owns(resource.data.recipientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      // Permite retirar avisos antiguos al deshacer la acción, también si nunca hubo aviso.
      allow delete: if signedIn() && (resource == null || (owns(resource.data.actorId) && actionRemoved()));
    }

    match /posts/{postId} {
      match /likes/{userId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow create: if owns(userId)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && (get(/databases/$(database)/documents/posts/$(postId)).data.authorId == userId
            || notificationAfter('like_' + postId + '_' + userId,
              get(/databases/$(database)/documents/posts/$(postId)).data.authorId, 'like', postId));
        allow update: if false;
        allow delete: if owns(userId)
          && (!exists(/databases/$(database)/documents/posts/$(postId))
            || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == userId
            || !existsAfter(/databases/$(database)/documents/notifications/$('like_' + postId + '_' + userId)));
      }

      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.authorId == request.auth.uid
        || request.query.limit <= 50);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId', 'imageUrl', 'imagePublicId', 'description', 'createdAt', 'location'
        ])
        && request.resource.data.authorId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.imageUrl.matches('https://res[.]cloudinary[.]com/iufz7yvd/image/upload/.*')
        && request.resource.data.imagePublicId is string
        && request.resource.data.imagePublicId.size() <= 255
        && request.resource.data.imagePublicId.matches('spotly/posts/' + request.auth.uid + '/[^/]+')
        && request.resource.data.createdAt == request.time
        && (!('location' in request.resource.data) || request.resource.data.location == null
          || request.resource.data.location is latlng);
      // Solo el autor puede cambiar la descripción; identidad, imagen, ubicación y fecha son inmutables.
      allow update: if owns(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description'])
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000
        && request.resource.data.description.matches('(?s).*[^\\s].*');
      allow delete: if owns(resource.data.authorId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
